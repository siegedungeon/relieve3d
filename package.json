{
  "name": "relieve3d",
  "version": "1.28.10",
  "description": "Convierte imágenes en modelos 3D por capas de color (llaveros, letreros, relieves) con vista previa 3D.",
  "main": "main.js",
  "scripts": {
    "test:nametree": "node --test test/name_tree.test.mjs && node test/e2e/run.mjs nametree",
    "test:nametree:print": "node test/name_tree_bambu.mjs",
    "test:keyring": "node --test test/keyring_3mf.test.mjs && node test/e2e/run.mjs keyring3mf",
    "test:clicker": "node --test test/clicker.test.mjs && node test/e2e/run.mjs clicker",
    "test:clicker:print": "node test/e2e/run.mjs clicker && node test/clicker_bambu.mjs",
    "test:canopener": "node --test test/canopener.test.mjs && node test/e2e/run.mjs canopener",
    "test:canopener:print": "node test/e2e/run.mjs canopener && node test/canopener_bambu.mjs",
    "test:theme": "node --test test/theme.test.mjs && node test/e2e/run.mjs theme",
    "test:laser": "node --test test/laser.test.mjs && node test/e2e/run.mjs laser",
    "test:pencil-batch": "node --test test/pencil_batch.test.mjs && node test/e2e/run.mjs pencil-batch",
    "postinstall": "node scripts/vendor.mjs",
    "prestart": "node scripts/vendor.mjs",
    "start": "electron .",
    "test": "node --test test/theme.test.mjs test/name_tree.test.mjs test/keyring_3mf.test.mjs test/clicker.test.mjs test/canopener.test.mjs && npm run test:laser:unit && npm run test:quote && npm run test:tiktok && npm run test:local && npm run test:inbox && node test/pipeline.test.mjs && node test/watertight.test.mjs && node test/features.test.mjs && node test/pencil.test.mjs && node test/micbody.test.mjs && node test/elements.test.mjs && node test/accuracy.test.mjs && node test/thicken.test.mjs && node test/counters.test.mjs && node test/coloring.test.mjs && node test/coloring-illustration.test.mjs && node test/coloring-curves.test.mjs && node test/coloring-decorations.test.mjs && node test/hablador.test.mjs && node test/hablador_mockup.test.mjs && node test/solidparts.test.mjs && node test/splitjob.test.mjs && node test/colorsplit.test.mjs && node test/colorcarve.test.mjs && node test/colorseams.test.mjs && node test/colorsculpt.test.mjs && node test/colorsculpt_fit.test.mjs && node test/phonestand.test.mjs",
    "test:e2e": "node test/e2e/run.mjs all",
    "test:quote": "node --test test/quotation.test.mjs test/quote_store.test.mjs",
    "test:tiktok": "node --test test/tiktok_studio.test.mjs test/tiktok_workspace.test.mjs test/tiktok_biblioteca.test.mjs",
    "test:local": "node --test test/local_links.test.mjs",
    "test:inbox": "node --test test/inbox_core.test.mjs test/inbox_client.test.mjs",
    "predist": "node scripts/vendor.mjs",
    "dist": "electron-builder --win nsis",
    "test:laser:unit": "node --test test/laser.test.mjs"
  },
  "author": "pabon",
  "license": "UNLICENSED",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/siegedungeon/relieve3d.git"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.3",
    "manifold-3d": "^3.5.4",
    "opentype.js": "^2.0.0",
    "polygon-clipping": "^0.15.7",
    "qrcode-generator": "^2.0.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "pngjs": "^7.0.0"
  },
  "build": {
    "appId": "com.relieve3d.app",
    "productName": "Relieve3D",
    "files": [
      "main.js",
      "preload.js",
      "build/icon.png",
      "src/**/*",
      "!test/**"
    ],
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "siegedungeon",
      "repo": "relieve3d"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Relieve3D"
    },
    "fileAssociations": [
      {
        "ext": "r3d",
        "name": "Proyecto Relieve3D"
      }
    ]
  }
}
